<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>dcc-office-host</AssemblyName>
    <RootNamespace>Office.Automation.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Office.Automation.Runtime/Office.Automation.Runtime.csproj" />
    <ProjectReference Include="../Office.Automation.OpenXml/Office.Automation.OpenXml.csproj" />
    <ProjectReference Include="../Office.Automation.Com/Office.Automation.Com.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand template registry (proposal §15.4): source of truth lives in
         templates/registry.json; the embedded copy keeps single-file
         publishes self-contained. -->
    <EmbeddedResource Include="../../templates/registry.json" LogicalName="Templates.registry.json" />
  </ItemGroup>

</Project>
