<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>dcc-office-host</AssemblyName>
    <RootNamespace>Office.Automation.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Office.Automation.Runtime/Office.Automation.Runtime.csproj" />
    <ProjectReference Include="../Office.Automation.OpenXml/Office.Automation.OpenXml.csproj" />
    <ProjectReference Include="../Office.Automation.Com/Office.Automation.Com.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../crates/office-protocol/office-rpc.catalog.json" LogicalName="Manifests.office-rpc.catalog.json" />
    <EmbeddedResource Include="../../manifests/schemas/*.json" LogicalName="Manifests.schemas.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
