<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Zero NuGet dependencies (dependency policy, 2026-08-16):
         System.IO.Packaging ships in the Microsoft.WindowsDesktop.App shared
         framework, referenced below without any package. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>DccMcp.Office.OpenXml</AssemblyName>
    <RootNamespace>Office.Automation.OpenXml</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Known-good OOXML skeletons (master/layout/theme/notesMaster/slide/
         notesSlide) generated by our own tooling; instantiated and patched
         by PptxWriter. -->
    <EmbeddedResource Include="Templates/*.xml" />
  </ItemGroup>

</Project>
