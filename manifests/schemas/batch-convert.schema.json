{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dcc-mcp.github.io/schemas/office/batch-convert.schema.json",
  "title": "office.batch.convert input",
  "description": "Input contract for office.batch.convert (proposal §15.1). The host expands glob patterns and routes each file to its own app sidecar.",
  "type": "object",
  "required": ["inputs", "output_directory"],
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "File paths or simple globs (*, ?, **/ for recursion)."
    },
    "target_format": {
      "type": "string",
      "enum": ["pdf"],
      "default": "pdf"
    },
    "backend": {
      "type": "string",
      "enum": ["auto", "desktop_com", "openxml", "graph"],
      "default": "auto"
    },
    "output_directory": {
      "type": "string",
      "description": "Existing or creatable directory for outputs."
    },
    "overwrite": {
      "type": "string",
      "enum": ["versioned", "fail", "overwrite"],
      "default": "versioned"
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["output_openable", "non_empty", "page_count_reasonable"]
      },
      "default": ["output_openable", "non_empty", "page_count_reasonable"]
    }
  }
}
