{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dcc-mcp.github.io/schemas/office/job-status.schema.json",
  "title": "office.job.get result",
  "type": "object",
  "required": [
    "job_id", "capability", "phase", "stage", "completed", "total",
    "cancel_requested", "created_at", "updated_at", "result", "error"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {"type": "string", "pattern": "^job:[a-f0-9]{32}$"},
    "capability": {"type": "string", "minLength": 1},
    "phase": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "partially_succeeded", "failed", "cancelled"]
    },
    "stage": {"type": "string", "minLength": 1},
    "completed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "cancel_requested": {"type": "boolean"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "result": {"type": ["object", "null"]},
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "indeterminate": {"type": "boolean"}
      },
      "required": ["code", "message", "indeterminate"],
      "additionalProperties": false
    }
  }
}
